# Set a unique, private value before using Docker Compose outside a local lab.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=

# Optional Google sign-in credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback
FRONTEND_URL=http://localhost:5174

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Docker host ports and browser-to-API URL. Change these if the default ports
# are already in use or if accessing the frontend from another device.
API_HOST_PORT=5001
WEB_HOST_PORT=5174
DOCKER_API_BASE=http://localhost:5001

# Used by the local Vite dev server, independently from Docker.
VITE_API_BASE=http://localhost:5000
